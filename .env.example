# Supabase — Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Razorpay (India) — https://dashboard.razorpay.com/app/keys
# Use Test Key ID while developing (starts with rzp_test_)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Never put SUPABASE_SERVICE_ROLE_KEY or Razorpay Key Secret in the frontend.
#
# Vercel: add the same VITE_* vars in
# Project → Settings → Environment Variables (Production + Preview)
# Then redeploy. Vite bakes env vars in at build time.
